diff --git a/src/components/ui.test.tsx b/src/components/ui.test.tsx
new file mode 100644
index 0000000..19e5e43
--- /dev/null
+++ b/src/components/ui.test.tsx
@@ -0,0 +1,106 @@
+// @vitest-environment jsdom
+import { act, cleanup, render, screen } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import axe from 'axe-core';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { AddressChip } from './ui';
+
+const ADDRESS = 'CCC7KAX4V4GJD6FVG6GSYQ4I2D2B3CWEOQMIX6YM4QBGXTA6INCGRUYC';
+const OTHER = 'CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA';
+
+afterEach(() => {
+  cleanup();
+  vi.restoreAllMocks();
+});
+
+describe('AddressChip', () => {
+  it('exposes the full 56-character accessible name while keeping the visual abbreviation', () => {
+    render(<AddressChip value={ADDRESS} label="Factory" />);
+    expect(ADDRESS).toHaveLength(56);
+    expect(screen.getByRole('group', { name: ADDRESS })).toBeTruthy();
+    expect(screen.getByText('CCC7KA…RUYC').getAttribute('aria-hidden')).toBe('true');
+    expect(screen.getByRole('button', { name: 'Copy Factory' }).getAttribute('type')).toBe(
+      'button',
+    );
+  });
+
+  it('passes axe checks for a labelled chip', async () => {
+    const { container } = render(<AddressChip value={ADDRESS} label="Factory" />);
+    const result = await axe.run(container, { rules: { 'color-contrast': { enabled: false } } });
+    expect(result.violations.map((x) => x.id)).toEqual([]);
+  });
+
+  it('copies the complete value using keyboard activation and announces success', async () => {
+    const user = userEvent.setup();
+    const copy = vi.spyOn(navigator.clipboard, 'writeText').mockResolvedValue();
+    render(<AddressChip value={ADDRESS} />);
+    await user.tab();
+    expect(document.activeElement).toBe(screen.getByRole('button', { name: 'Copy address' }));
+    await user.keyboard('{Enter}');
+    expect(copy).toHaveBeenCalledExactlyOnceWith(ADDRESS);
+    expect(screen.getByRole('status').textContent).toBe('Copied');
+  });
+
+  it('announces refused clipboard permission without reporting success', async () => {
+    const user = userEvent.setup();
+    vi.spyOn(navigator.clipboard, 'writeText').mockRejectedValue(
+      new DOMException('Denied', 'NotAllowedError'),
+    );
+    render(<AddressChip value={ADDRESS} />);
+    await user.click(screen.getByRole('button', { name: 'Copy address' }));
+    expect(screen.getByRole('status').textContent).toBe('Copy unavailable');
+    expect(screen.getByRole('button', { name: 'Copy address' }).hasAttribute('disabled')).toBe(
+      false,
+    );
+  });
+
+  it('handles an unavailable clipboard API', async () => {
+    const user = userEvent.setup();
+    const descriptor = Object.getOwnPropertyDescriptor(navigator, 'clipboard');
+    Object.defineProperty(navigator, 'clipboard', { configurable: true, value: undefined });
+    try {
+      render(<AddressChip value={ADDRESS} />);
+      await user.click(screen.getByRole('button', { name: 'Copy address' }));
+      expect(screen.getByRole('status').textContent).toBe('Copy unavailable');
+    } finally {
+      if (descriptor) Object.defineProperty(navigator, 'clipboard', descriptor);
+    }
+  });
+
+  it('blocks repeated copies while the clipboard operation is pending', async () => {
+    const user = userEvent.setup();
+    let finish!: () => void;
+    const copy = vi.spyOn(navigator.clipboard, 'writeText').mockReturnValue(
+      new Promise<void>((resolve) => {
+        finish = resolve;
+      }),
+    );
+    render(<AddressChip value={ADDRESS} />);
+    const button = screen.getByRole('button', { name: 'Copy address' });
+    await user.click(button);
+    await user.click(button);
+    expect(button.hasAttribute('disabled')).toBe(true);
+    expect(copy).toHaveBeenCalledTimes(1);
+    await act(async () => finish());
+    expect(button.hasAttribute('disabled')).toBe(false);
+  });
+
+  it('does not attribute an old pending copy to an updated address', async () => {
+    const user = userEvent.setup();
+    let finish!: () => void;
+    vi.spyOn(navigator.clipboard, 'writeText').mockReturnValue(
+      new Promise<void>((resolve) => {
+        finish = resolve;
+      }),
+    );
+    const { rerender } = render(<AddressChip value={ADDRESS} />);
+    await user.click(screen.getByRole('button', { name: 'Copy address' }));
+    rerender(<AddressChip value={OTHER} />);
+    await act(async () => finish());
+    expect(screen.getByRole('group', { name: OTHER })).toBeTruthy();
+    expect(screen.getByRole('status').textContent).toBe('');
+    expect(screen.getByRole('button', { name: 'Copy address' }).hasAttribute('disabled')).toBe(
+      false,
+    );
+  });
+});
