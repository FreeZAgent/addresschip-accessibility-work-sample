+/** Keyed by the address: a pending copy cannot report success for a new value. */
+function AddressCopy({ value, label }: { value: string; label: string | undefined }) {
+  const [status, setStatus] = useState<'idle' | 'copying' | 'copied' | 'failed'>('idle');
+
+  async function copy() {
+    setStatus('copying');
+    try {
+      await navigator.clipboard.writeText(value);
+      setStatus('copied');
+    } catch {
+      // Clipboard permission can be refused, and HTTP pages may have no API.
+      setStatus('failed');
+    }
+  }
+
+  return (
+    <>
+      <button
+        type="button"
+        aria-label={`Copy ${label ?? 'address'}`}
+        disabled={status === 'copying'}
+        onClick={() => void copy()}
+        className="rounded px-1.5 py-0.5 text-xs underline focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-50"
+      >
+        Copy
+      </button>
+      <span role="status" className="text-xs text-neutral-500">
+        {status === 'copied' ? 'Copied' : status === 'failed' ? 'Copy unavailable' : ''}
+      </span>
+    </>
+  );
+}
